{
  "name": "aether",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "pnpm --filter @aether/game-client dev",
    "build": "pnpm --filter @aether/game-client build",
    "start": "pnpm --filter @aether/game-client start",
    "typecheck": "tsc --noEmit && pnpm --filter @aether/game-client typecheck",
    "validate:content": "node tools/content/validate.ts",
    "test": "node --test packages/content/test/*.test.ts packages/game-core/test/*.test.ts apps/game-client/test/*.test.ts",
    "test:browser": "playwright test",
    "check": "pnpm typecheck && pnpm validate:content && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
