  "manifest": {
    "id": "dawnwell_glade_pack",
    "name": "Dawnwell Glade — M1 sample",
    "schemaVersion": 1,
    "runtimeCompatibility": "aether_v1",
    "releaseId": "dawnwell_m1_sample",
    "status": "sample"
  },
  "rules": {
    "movement": {
      "input": "click_to_move",
      "path": "straight_line",
      "position": "ground_point",
      "invalidDestination": "clamp_finite_reject_malformed",
      "diagonalSpeed": "normalized",
      "collision": "pass_through",
      "renderDepth": "ground_y",
      "groundMoveRetainsSelection": true
    },
    "combat": {
      "input": "one_press_one_action",
      "selectionAttacks": false,
      "keyRepeat": "ignore",
      "approach": "approach_then_strike_once",
      "distance": "euclidean_ground_points",
      "maxPendingActions": 1,
      "pendingReplacement": "valid_request_replaces",
      "cancelPendingOn": [
        "ground_move",
        "retarget",
        "target_death",
        "death",
        "room_exit",
        "disconnect"
      ],
      "spendAndCooldown": "at_execution",
      "rejectedInput": "preserve_valid_pending",
      "actionExecution": "stop_movement",
      "mendCancelsPending": true,
      "deathDisablesInput": true,
      "textInputSuppressesShortcuts": true,
      "panelClicksReachWorld": false
    },
    "recovery": {
      "outOfCombatDelayMs": 6000,
      "requireNoPursuingEnemy": true,
      "healthPerSecond": 6,
      "manaPerSecond": 6,
      "respawnMs": 5000,
      "respawnResources": "full",
      "deathProgressLoss": "none",
      "resetCooldownsOnRespawn": false
    },
    "room": {
      "capacity": 8,
      "reconnectGraceMs": 30000,
      "identity": "one_character_per_browser_guest_token",
      "retainedDisconnectedCounts": true,
      "retainedDisconnectedVulnerable": true,
      "disconnectStopsMovement": true,
      "disconnectCancelsPending": true,
      "replayCommandsOnReconnect": false,
      "resetResourcesOnReconnect": false,
      "resetCooldownsOnReconnect": false,
      "lateReconnectSpawn": "map_player_spawn",
      "expiry": "remove_presence_and_contributions_retain_recovery",
      "full": "retryable_rejection"
    },
    "rewards": {
      "eligibility": "damaging_contributors_remaining_in_room",
      "distribution": "full_personal",
      "retainThroughDeath": true,
      "retainThroughRespawn": true,
      "retainedDisconnectedEligible": true,
      "clearOnReset": true,
      "clearOnRemoval": true,
      "resolution": "once_per_encounter_atomic"
    },
    "inventory": {
      "slots": 12,
      "equipmentSlots": [
        "weapon"
      ],
      "equippedItemsRemainOwned": true,
      "bonuses": "replace",
      "changesRequire": "alive_out_of_combat",
      "changesResetResourcesOrCooldowns": false
    },
    "chat": {
      "scope": "room",
      "format": "plain_text",
      "disconnectedCanSend": false
    },
    "authority": "server_validated_intentions_and_timestamps"
  },
